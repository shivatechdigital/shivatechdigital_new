# CSS files ko cache mat karo - instant changes ke liye
<IfModule mod_headers.c>
    <FilesMatch "\.css$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# LiteSpeed cache disable for CSS
<IfModule LiteSpeed>
    CacheDisable public /
</IfModule>
